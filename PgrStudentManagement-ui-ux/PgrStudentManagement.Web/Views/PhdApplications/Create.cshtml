@model PgrStudentManagement.Web.Modules.PhdApplications.Models.CreatePhdApplicationViewModel

@*
    ===========================================================================
    UI/UX & ACCESSIBILITY LAB — STARTING POINT (Create.cshtml)
    ===========================================================================
    Right now, every field is a plain <input type="text"> preceded by a <span>
    (instead of a semantic <label>), with no hints, no fieldsets, and no
    validation messages.

    Follow LabResources/lab1-instructions.md and copy/adapt the ready-made
    snippets from LabResources/code-snippets.md:
      - Part 1 (Quick Wins):
          * Task 1: Fix the low-contrast .btn-primary colour in wwwroot/css/site.css (Snippet 1.A)
          * Task 2: Replace every <span class="form-label"> with <label asp-for="..." class="form-label"></label> (Snippet 1.B)
      - Part 2: Change @model to CreatePhdApplicationViewModel & remove system fields (Snippet 2.A & 2.B)
      - Part 3: Replace plain text boxes with proper semantic controls (Snippets 3.A–3.D)
      - Part 4: Improve form layout, section grouping (.form-section, .form-grid-2),
                and proportionate input widths (.input-width-sm, .input-width-md) (Snippets 4.A & 4.B)
      - Part 5: Add human-readable display names, hints (aria-describedby),
                and live character counter (Snippets 5.A & 5.B)
      - Part 7: Add accessible error summary + inline errors (Snippets 7.A & 7.B)
      - Part 8: Add HTML client-side validation attributes (Snippet 8.A)
    ===========================================================================
*@

@{
    // TODO (Lab Part 7): Prefix title with "Error: " when !ViewData.ModelState.IsValid (see Snippet 7.A)
    ViewData["Title"] = "Create PhD Application";
}

<h1>Create PhD Application</h1>

@{
    var hasErrors = !ViewData.ModelState.IsValid;
    ViewData["Title"] = hasErrors
        ? "Error: Create PhD Application"
        : "Create PhD Application";
}

@if (hasErrors)
{
    <div id="error-summary"
         class="alert alert-danger"
         role="alert"
         aria-labelledby="error-summary-title"
         tabindex="-1">
        <h2 id="error-summary-title" class="h5">There is a problem</h2>
        <ul class="mb-0">
            @foreach (var entry in ViewData.ModelState)
            {
                foreach (var error in entry.Value.Errors)
                {
                    <li>
                        @if (!string.IsNullOrEmpty(entry.Key))
                        {
                            <a href="#@entry.Key" class="alert-link">@error.ErrorMessage</a>
                        }
                        else
                        {
                            @error.ErrorMessage
                        }
                    </li>
                }
            }
        </ul>
    </div>
    <script>
        document.getElementById('error-summary')?.focus();
    </script>
}

<div class="form-container">
    <form asp-action="Create" method="post">
        <section class="form-section">
            <h2>Section 1: About you</h2>

            <div class="form-grid-2">
                <div class="mb-3">
                    <label asp-for="FirstName" class="form-label">First Name</label>
                    <input asp-for="FirstName" class="form-control" autocomplete="given-name" spellcheck="false" required maxlength="100" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="LastName" class="form-label">Last Name</label>
                    <input asp-for="LastName" class="form-control" autocomplete="family-name" spellcheck="false" required maxlength="100" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>
            </div>
            @{
                var emailInvalid = ViewData.ModelState.ContainsKey(nameof(Model.EmailAddress))
                    && ViewData.ModelState[nameof(Model.EmailAddress)]!.Errors.Count > 0;
            }
            <div class="mb-3">
                    <label asp-for="EmailAddress" class="form-label">Email Address</label>
                    <div id="EmailAddress-hint" class="form-text">We will use this email address to send your application reference and updates.</div>
                    <input asp-for="EmailAddress" class="form-control input-width-md" autocomplete="email" spellcheck="false" aria-describedby="EmailAddress-hint" type="email" required maxlength="255" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
        </section>

        <section class="form-section">
            <h2>Section 2: Programme and mode of study</h2>

            <div class="mb-3">
                <label asp-for="ProgrammeCode" class="form-label">Programme Code</label>
                <select asp-for="ProgrammeCode" class="form-select input-width-md" required >
                    <option value="">Select a programme...</option>
                    <option value="PHD-COMP">Phd Computing (PHD-COMP)</option>
                    <option value="PHD-DESIGN">Phd Design (PHD-DESIGN)</option>
                    <option value="MPHIL-COMP">MPhil Computing (MPHIL-COMP)</option>
                </select>
                <span asp-validation-for="ProgrammeCode" class="text-danger"></span>
            </div>
            <fieldset class="mb-3">
                <legend class="form-label">Mode of study</legend>
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="ModeOfStudy" id="ModeOfStudyFullTime" value="Full-time" required />
                    <label class="form-check-label" for="ModeOfStudyFullTime">Full-time (typically 3 years)</label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" asp-for="ModeOfStudy" id="ModeOfStudyPartTime" value="Part-time" required />
                    <label class="form-check-label" for="ModeOfStudyPartTime">Part-time (typically 6 years)</label>
                </div>
                <span asp-validation-for="ModeOfStudy" class="text-danger"></span>
            </fieldset> @* fastpass failure: label for and input id mismatch causing unnamed *@
            <div class="mb-3">
                <label asp-for="ProposedStartDate" class="form-label">Proposed Start Date</label>
                <div id="ProposedStartDate-hint" class="form-text">
                    For example, 01/10/2027 Most cohorts begin in October or January.
                </div>
                <input 
                    asp-for="ProposedStartDate" 
                    type="date"
                    required
                    class="form-control input-width-sm"
                    aria-describedby="ProposedStartDate-hint" />
                <span asp-validation-for="ProposedStartDate" class="text-danger"></span>
            </div>
        </section>

        <section>
            <h2>Section 3: Research proposal</h2>

            <div class="mb-3">
                <label asp-for="ProposedThesisTitle" class="form-label">Proposed Thesis Title</label>
                <div id="ProposedThesisTitle-hint" class="form-text">
                    Provide a working title fro your proposed research project (up to 300 characters).
                </div>
                <input asp-for="ProposedThesisTitle" class="form-control" aria-describedby="ProposedThesisTitle-hint" required maxlength="300" />
                <span asp-validation-for="ProposedThesisTitle" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ResearchSummary" class="form-label">Research summary (optional)</label>
                <div id="ResearchSummary-hint" class="form-text">
                    Outline your research question, background context, and proposed methodology in up to 2,000 characters.
                </div>
                <textarea asp-for="ResearchSummary"
                          rows="6"
                          class="form-control"
                          data-maxlength="2000"
                          maxlength="2000"
                          aria-describedby="ResearchSummary-hint ResearchSummary-count"></textarea>
                <div id="ResearchSummary-count" class="form-text" aria-live="polite">
                    You have 2,000 characters remaining
                </div>
                <span asp-validation-for="ResearchSummary" class="text-danger"></span>
            </div>
        </section>

        <section class="form-section">
            <h2>Section 4: Funding and supervision</h2>

            <fieldset class="mb-3">
                <legend class="form-label">How will your PhD studies be funded?</legend>

                @foreach (var item in Html.GetEnumSelectList<FundingType>())
                {
                    var radioId = $"FundingSource-{item.Value}";
                    <div class="form-check">
                        <input class="form-check-input"
                               type="radio"
                               required
                               name="FundingSource"
                               id="@radioId"
                               value="@item.Value"
                               checked="@(Model.FundingSource.ToString() == item.Text || ((int?)Model.FundingSource)?.ToString() == item.Value)" />
                        <label class="form-check-label" for="@radioId">
                            @item.Text
                        </label>
                    </div>
                }

                <span asp-validation-for="FundingSource" class="text-danger"></span>
            </fieldset>

            @{
                var supervisors = ViewBag.Supervisors
                    as IReadOnlyList<PgrStudentManagement.Web.Modules.AcademicSupervisors.Contracts.SupervisorSummary>
                    ?? Array.Empty<PgrStudentManagement.Web.Modules.AcademicSupervisors.Contracts.SupervisorSummary>();
            }
            <div class="mb-3">
                <label asp-for="ProposedSupervisorStaffNumber" class="form-label">
                    Proposed main supervisor (optional)
                </label>
                <div id="ProposedSupervisor-hint" class="form-text">
                    Only academic staff eligible to act as a Main Supervisor are listed. 
                    Leave blank if you have not yet identified a supervisor.
                </div>
                <select asp-for="ProposedSupervisorStaffNumber"
                        class="form-select input-width-md"
                        aria-describedby="ProposedSupervisor-hint">
                    <option value="">I have not identified a supervisor yet</option>
                    @foreach (var supervisor in supervisors)
                    {
                        <option value="@supervisor.StaffNumber">
                            @supervisor.DisplayName (@supervisor.StaffNumber)
                        </option>
                    }
                </select>
                <span asp-validation-for="ProposedSupervisorStaffNumber" class="text-danger"></span>
            </div>
        </section>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">
                Submit application
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                Cancel
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            const textarea = document.getElementById('ResearchSummary');
            const counter = document.getElementById('ResearchSummary-count');
            if (!textarea || !counter) return;

            const max = parseInt(textarea.getAttribute('data-maxlength') || '2000', 10);

            function updateCount() {
                const remaining = max - textarea.value.length;
                if (remaining >= 0) {
                    counter.textContent = `You have ${remaining.toLocaleString()} characters remaining`;
                    counter.classList.remove('text-danger');
                } else {
                    counter.textContent = `You have ${Math.abs(remaining).toLocaleString()} characters too many`;
                    counter.classList.add('text-danger');
                }
            }

            textarea.addEventListener('input', updateCount);
            updateCount();
        })();
    </script>
}