@using PgrStudentManagement.Web.Models
@model IEnumerable<PgrStudentManagement.Web.Models.Student>


@{
    ViewData["Title"] = "Student Details";
}

<h1>Student Details</h1>

<table class="table">
    <thead>
        <tr>
            <th>Student number</th>
            <th>Name</th>
            <th>Course</th>
            <th>Mode of study</th>
            <th>Start date</th>
            <th>Status</th>
            <th>Details</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.StudentNumber</td>
                <td>@student.FullName</td>
                <td>@student.Course</td>
                <td>@student.ModeOfStudy</td>
                <td>@student.StartDate</td>
                <td>@student.Status</td>
                <td>
                    <a asp-action="EnrolmentDetails"
                        asp-route-studentNumber="@student.StudentNumber"
                        asp-route-returnTo="administrator">
                        Details
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="mt-3">
    <a asp-controller="Students" asp-action="Administrator">Return to options</a>
</div>

@* possible style is to use card layout for each student, and a modal view for the details *@
