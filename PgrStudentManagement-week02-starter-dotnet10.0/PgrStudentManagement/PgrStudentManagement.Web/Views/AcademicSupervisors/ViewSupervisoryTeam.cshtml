@model IEnumerable<PgrAcademicSupervisorManagement.Web.Models.SupervisoryAssignment>

@{
    ViewData["Title"] = "View Supervisory Team";
}

<h1>View Supervisory Team</h1>


<form asp-action="ViewSupervisoryTeam" method="get" id="view-supervisory-team-form">
    <div class="form-group">
        <label for="studentNumber" class="control-label">Student Number</label>
        <input type="text" name="studentNumber" id="studentNumber" class="form-control" required />
    </div>
    <br />
    <div class="btn-group" role="group">
        <button type="submit" class="btn btn-primary" id="view-supervisory-team-submit">View Supervisory Team</button>
        <a asp-controller="AcademicSupervisors" asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
</form>

@if (Model != null)
{
    <h2>Supervisory Team for Student - @Model.FirstOrDefault()?.StudentNumber</h2>
    <table class="table">
        <thead>
            <tr>
                <th>Staff Number</th>
                <th>Role</th>
                <th>Start Date</th>
                <th>End Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var assignment in Model)
            {
                <tr>
                    <td>@assignment.AcademicSupervisorNumber</td>
                    <td>@assignment.Role</td>
                    <td>@assignment.StartDate.ToShortDateString()</td>
                    <td>@(assignment.EndDate.HasValue ? assignment.EndDate.Value.ToShortDateString() : "Current")</td>
                </tr>
            }
        </tbody>
    </table>
}

@if (TempData["NoAssignmentsFound"] is string message)
{
    <div class="alert alert-info" role="alert">
        @message
    </div>
}

<div class="mt-3">
    <a asp-action="Index">Return to Supervisors</a>
</div>

@section Scripts {
    <script>
        document.getElementById("view-supervisory-team-form").addEventListener("submit", function () {
            const submitButton = document.getElementById("view-supervisory-team-submit");
            submitButton.disabled = true;
            submitButton.textContent = "Viewing...";
        });
    </script>
}
