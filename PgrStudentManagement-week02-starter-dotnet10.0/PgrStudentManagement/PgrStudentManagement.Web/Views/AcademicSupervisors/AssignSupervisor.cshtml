@model PgrAcademicSupervisorManagement.Web.Models.SupervisoryAssignment
@using PgrAcademicSupervisorManagement.Web.Models



@{
    ViewData["Title"] = "Assign Supervisors";
}
    

@if (TempData["AssignSupervisorSuccess"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

<h1>Assign a Supervisor to a Student</h1>

<form asp-action="AssignSupervisor" method="post" id="assign-supervisor-form"> @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="form-group">
        <label asp-for="StudentNumber" class="control-label"> Student Number </label>
        <input asp-for="StudentNumber" class="form-control" type="text" required/>
        <span asp-validation-for="StudentNumber" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="AcademicSupervisorNumber" class="control-label"> Staff Number </label>
        <input asp-for="AcademicSupervisorNumber" class="form-control" type="text" required/>
        <span asp-validation-for="AcademicSupervisorNumber" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Role" class="control-label"> Role of Supervisor</label>
        <select asp-for="Role" class="form-control" asp-items="@Html.GetEnumSelectList<SupervisoryRole>()" required>
            <option value="">Select Supervisor Role</option>
        </select>
        <span asp-validation-for="Role" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="StartDate" class="control-label"> Start Date </label>
        <input asp-for="StartDate" class="form-control" type="date" required/>
        <span asp-validation-for="StartDate" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="ExceptionAuthorised" class="control-label"> Has an exception been Authorised ? </label>
        <select asp-for="ExceptionAuthorised" class="form-control" type="bool" required>
            <option value="">Select Yes or No</option>
            <option value="true">Yes</option>
            <option value="false">No</option>
        </select>
        <span asp-validation-for="ExceptionAuthorised" class="text-danger"></span>
    </div>
    <br />
    <div class="btn-group" role="group">
        <button type="submit" class="btn btn-primary" id="assign-supervisor-submit">Assign Supervisor</button>
        <a asp-controller="AcademicSupervisors" asp-action="AssignSupervisor" class="btn btn-secondary">Cancel</a>
    </div>
</form>


<div class="mt-3">
    <a asp-action="Index">Return to Supervisors</a>
</div>

@section Scripts {
    <script>
        document.getElementById("assign-supervisor-form").addEventListener("submit", function () {
            const submitButton = document.getElementById("assign-supervisor-submit");
            submitButton.disabled = true;
            submitButton.textContent = "Assigning...";
        });
    </script>
}