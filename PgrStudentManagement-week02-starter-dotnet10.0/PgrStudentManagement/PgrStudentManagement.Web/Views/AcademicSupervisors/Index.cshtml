@model IEnumerable<PgrAcademicSupervisorManagement.Web.Models.AcademicSupervisor>

@{
    ViewData["Title"] = "Academic Supervisors";
}
    
@if (TempData["NoSupervisorsFound"] != null)
{
    <div class="alert alert-info" role="alert">
        @TempData["NoSupervisorsFound"]
    </div>
}

@if (TempData["CreateSupervisorSuccess"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}

<h1>Academic Supervisors</h1>

<div class="mb-3 d-flex flex-wrap align-items-center gap-3">
    <a asp-action="CreateSupervisor">Add new supervisor</a>
    <a asp-action="AssignSupervisor">Assign Supervisor to Student</a>
    @* <a asp-action="">View Supervisory Team</a> *@
</div>
<table class="table">
    <thead>
        <tr>
            <th>Staff number</th>
            <th>Name</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var supervisor in Model)
        {
            <tr>
                <td>@supervisor.StaffNumber</td>
                <td>@supervisor.FullName</td>
                <td>
                    <a asp-action="SupervisorDetails"
                       asp-route-staffNumber="@supervisor.StaffNumber">
                        Details
                    </a>
                    |
                    @* add more options here *@
                </td>
            </tr>
        }
    </tbody>
</table>


<div class="mt-3">
    <a asp-controller="Students" asp-action="Index">Return to students</a>
</div>