@model PgrResearchActivity.Web.Models.ResearchActivity

@{
    ViewData["Title"] = "Research Activity Details";

    string FormatDetailValue(object? value)
    {
        if (value is System.Collections.IEnumerable values and not string)
        {
            return string.Join(", ", values.Cast<object?>().Select(FormatDetailValue));
        }

        return value?.ToString() ?? string.Empty;
    }
}

<h1>Research Activity Details</h1>

<dl>
    <dt>Activity ID</dt>
    <dd>@Model.ActivityId</dd>
    <dt>Student number</dt>
    <dd>@Model.StudentNumber</dd>
    <dt>Title</dt>
    <dd>@Model.Title</dd>
    <dt>Type</dt>
    <dd>@Model.ActivityType</dd>
    <dt>Activity date</dt>
    <dd>@Model.ActivityDate.ToString("yyyy-MM-dd")</dd>
    <dt>Created on</dt>
    <dd>@Model.CreatedOn.ToUniversalTime().ToString("u")</dd>
    <dt>Tags</dt>
    <dd>@string.Join(", ", Model.Tags)</dd>
</dl>

<h2>Details</h2>
@if (Model.Details.Count == 0)
{
    <p>No additional details were recorded.</p>
}
else
{
    <dl>
        @foreach (var detail in Model.Details)
        {
            <dt>@detail.Key</dt>
            <dd>@FormatDetailValue(detail.Value)</dd>
        }
    </dl>
}

<a asp-action="Index" asp-route-studentNumber="@Model.StudentNumber">Back to activities</a>
