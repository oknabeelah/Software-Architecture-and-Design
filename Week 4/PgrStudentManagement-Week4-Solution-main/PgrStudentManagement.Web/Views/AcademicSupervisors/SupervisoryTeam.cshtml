@model PgrStudentManagement.Web.Modules.AcademicSupervisors.Models.SupervisoryTeamViewModel

@{
    ViewData["Title"] = $"Supervisory Team - {Model.Student.DisplayName}";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2>Supervisory Team</h2>
        <h5 class="text-muted">Student: @Model.Student.DisplayName (@Model.Student.StudentNumber)</h5>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Assign" asp-route-studentNumber="@Model.Student.StudentNumber" class="btn btn-primary">
            Assign Academic Supervisor
        </a>
        <a asp-controller="Student" asp-action="Details" asp-route-studentNumber="@Model.Student.StudentNumber" class="btn btn-outline-secondary">
            Back to Student Details
        </a>
    </div>
</div>

@if (Model.Assessment.IsComplete)
{
    <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
        <div>
            <strong>Supervisory Arrangement Complete:</strong> The supervisory team satisfies institutional requirements (Institution-employed Director of Studies and First Supervisor assigned).
        </div>
    </div>
}
else
{
    <div class="alert alert-warning mb-4" role="alert">
        <h6 class="alert-heading">Supervisory Arrangement Incomplete</h6>
        <ul class="mb-0">
            @foreach (var issue in Model.Assessment.Issues)
            {
                <li>@issue</li>
            }
        </ul>
    </div>
}

@if (!Model.Assignments.Any())
{
    <div class="alert alert-info">
        <p class="mb-0">No supervisory assignments found for this student.</p>
    </div>
}
else
{
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0">Supervisory Assignments</h5>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Role</th>
                        <th>Supervisor</th>
                        <th>Staff Number</th>
                        <th>Employment</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Status</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Assignments)
                    {
                        <tr>
                            <td><strong>@item.Assignment.Role</strong></td>
                            <td>
                                @if (item.Supervisor is not null)
                                {
                                    <a asp-action="Details" asp-route-staffNumber="@item.Supervisor.StaffNumber">
                                        @item.Supervisor.FullName
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">Unknown</span>
                                }
                            </td>
                            <td>@item.Assignment.SupervisorStaffNumber</td>
                            <td>
                                @if (item.Supervisor is not null)
                                {
                                    <span class="badge @(item.Supervisor.EmploymentType == PgrStudentManagement.Web.Modules.AcademicSupervisors.Models.SupervisorEmploymentType.InstitutionEmployed ? "bg-success" : "bg-secondary")">
                                        @item.Supervisor.EmploymentType
                                    </span>
                                }
                            </td>
                            <td>@item.Assignment.StartDate.ToString("dd/MM/yyyy")</td>
                            <td>@(item.Assignment.EndDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                            <td>
                                @if (item.Assignment.Current)
                                {
                                    <span class="badge bg-primary">Current</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Historical</span>
                                }
                            </td>
                            <td>
                                @if (item.Assignment.ExceptionAuthorised)
                                {
                                    <span class="badge bg-warning text-dark">Exception Authorised</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
