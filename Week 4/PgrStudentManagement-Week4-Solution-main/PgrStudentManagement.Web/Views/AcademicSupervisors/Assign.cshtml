@model PgrStudentManagement.Web.Modules.AcademicSupervisors.Models.AssignSupervisorViewModel

@{
    ViewData["Title"] = $"Assign Supervisor - {Model.Student?.DisplayName ?? Model.StudentNumber}";
}

<div class="card shadow-sm mb-4">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">Assign Academic Supervisor</h4>
    </div>
    <div class="card-body">
        <h5 class="card-subtitle mb-3 text-muted">
            Student: @(Model.Student?.DisplayName ?? Model.StudentNumber) (@Model.StudentNumber)
        </h5>

        <form asp-action="Assign" method="post">
            <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

            <input type="hidden" asp-for="StudentNumber" />

            <div class="mb-3">
                <label asp-for="StaffNumber" class="form-label">Select Academic Supervisor <span class="text-danger">*</span></label>
                <select asp-for="StaffNumber" class="form-select" required>
                    <option value="">-- Choose Supervisor --</option>
                    @foreach (var s in Model.AvailableSupervisors)
                    {
                        <option value="@s.StaffNumber">
                            @s.FullName (@s.StaffNumber) - @s.EmploymentType [@string.Join(", ", s.EligibleRoles)]
                        </option>
                    }
                </select>
                <span asp-validation-for="StaffNumber" class="text-danger"></span>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Role" class="form-label">Supervisory Role <span class="text-danger">*</span></label>
                    <select asp-for="Role" class="form-select" asp-items="Html.GetEnumSelectList<PgrStudentManagement.Web.Modules.AcademicSupervisors.Models.SupervisoryRole>()"></select>
                    <span asp-validation-for="Role" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="StartDate" class="form-label">Start Date <span class="text-danger">*</span></label>
                    <input asp-for="StartDate" type="date" class="form-control" required />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-4 form-check">
                <input asp-for="ExceptionAuthorised" class="form-check-input" type="checkbox" id="exceptionCheck" />
                <label class="form-check-label" for="exceptionCheck">
                    Authorise Exception for 4th Supervisor
                </label>
                <div class="form-text">Check only if an authorised exception has been approved for a team exceeding 3 supervisors.</div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Assign Supervisor</button>
                <a asp-action="SupervisoryTeam" asp-route-studentNumber="@Model.StudentNumber" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
