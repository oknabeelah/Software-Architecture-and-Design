' Sequence Diagram for W2-UC03: Update Student Status'
@startuml

actor CollegeAdministrator
participant IndexView
participant StudentsController
participant Students
participant EditStudentStatusView


CollegeAdministrator -> IndexView : select Edit Student Status
IndexView -> StudentsController : EditStatus(studentNumber)
StudentsController -> Students : Find student
' Students or StudentsController ?
StudentsController -> EditStudentStatusView : displays matching Student's status and available status values

alt Student found
    Students -> StudentsController: read Student
    StudentsController -> EditStudentStatusView : View(student) - displays matching Student's status and available status values
    note right
        Display the form for editing the student's status.
    end note
    CollegeAdministrator -> EditStudentStatusView : select valid status and submit form
    alt Valid status
        EditStudentStatusView -> StudentsController : EditStatus(studentNumber, newStatus)
        StudentsController -> Students : Update student status
        Students --> StudentsController : updated Student
        StudentsController -> EditStudentStatusView : display success message and updated status
    else Invalid status
        StudentsController -> EditStudentStatusView: display validation errors
    end
else Student not found
    StudentsController -> EditStudentStatusView : NotFound()
    note right
        Student not found
    end note
end

note over Student
    Student status property is changed in UC03.
end note

@enduml